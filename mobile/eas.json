{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "release": {
      "android": {
        "buildType": "apk",
        "keystore": {
          "keystorePath": "./eticket-release.keystore",
          "keystorePassword": "process.env.KEYSTORE_PASSWORD",
          "keyAlias": "eticket",
          "keyPassword": "process.env.KEY_PASSWORD"
        }
      }
    }
  }
}
